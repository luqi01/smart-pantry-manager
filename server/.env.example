# Copy this file to .env and fill in your own connection string.
# .env is gitignored - never commit real credentials.
#
# Supabase: Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" URI and replace [YOUR-PASSWORD] with the database
# password you set when the project was created.
#
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Port the API listens on. The Android app defaults to 10.0.2.2 on this port,
# which is how the emulator reaches the host machine's localhost.
PORT=3000
