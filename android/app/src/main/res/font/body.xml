<?xml version="1.0" encoding="utf-8"?>
<!--
  Archivo, for everything read in quantity and for the stamped labels.

  A revival of the 19th-century American grotesques cut for newspapers and
  shelf tickets, so it is sturdy at 13sp, its caps letterspace without falling
  apart, and it has flat terminals and a real double-storey g rather than the
  smoothed-off geometry of the sans every app ships with.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/archivo_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/archivo_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/archivo_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
