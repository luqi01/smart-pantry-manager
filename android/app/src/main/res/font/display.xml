    <font
        android:font="@font/bricolage_grotesque_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/bricolage_grotesque_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
