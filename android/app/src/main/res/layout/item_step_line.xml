<?xml version="1.0" encoding="utf-8"?>
<!-- A numbered line. The number sits in the margin where the index sits on
     every other list, rather than inside a coloured disc: a disc is a shape
     drawn for its own sake, and the number alone already says the steps are
     ordered. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/text_number"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingEnd="@dimen/space_sm"
        tools:text="1"
        style="@style/Text.Index" />

    <TextView
        android:id="@+id/text_step"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Text.Body" />
</LinearLayout>
