<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_2xl">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2xl"
                android:indeterminateTint="@color/paprika"
                android:visibility="gone" />

            <!-- Primary list. Given the most room on the screen and the only
                 heading set in the display face. -->
            <TextView
                android:id="@+id/heading_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/gutter"
                android:text="@string/heading_suggested"
                android:textColor="@color/ink"
                style="@style/Text.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_2xs"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/heading_suggested_sub"
                style="@style/Text.Meta" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/empty_suggestions"
                android:visibility="gone"
                style="@style/Text.Body" />

            <!-- A generous gap, not a divider line, does the separating here.
                 The two lists mean different things and the space says so. -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/rule_thin"
                android:layout_marginStart="@dimen/gutter"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginEnd="@dimen/gutter"
                android:background="@color/rule" />

            <TextView
                android:id="@+id/heading_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/heading_almost"
                android:textColor="@color/mustard"
                style="@style/Text.Stamp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/empty_almost"
                android:visibility="gone"
                style="@style/Text.Body" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
