<?xml version="1.0" encoding="utf-8"?>
<!--
  Two lists that mean different things, so they are built out of different
  material rather than the same rows under a different heading.

  The first sits on the paper: full width, largest headline on the screen, one
  row per recipe you can cook right now. The second sits inside a tinted band
  that runs edge to edge, which marks it as a secondary, optional list without
  needing a line of explanation - and fills the lower half of the screen that
  used to be empty whenever nothing was one ingredient short.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2xl"
                android:indeterminateTint="@color/tomato"
                android:visibility="gone" />

            <!-- Primary list. Given the most room on the screen and the only
                 heading set in the display face. -->
            <TextView
                android:id="@+id/heading_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/gutter"
                android:text="@string/heading_suggested"
                android:textColor="@color/ink"
                style="@style/Text.Screen" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_2xs"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/heading_suggested_sub"
                style="@style/Text.Meta" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_lg"
                android:text="@string/empty_suggestions"
                android:visibility="gone"
                style="@style/Text.Body" />

            <LinearLayout
                android:id="@+id/panel_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/citron_wash"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    android:id="@+id/heading_almost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingEnd="@dimen/gutter"
                    android:text="@string/heading_almost"
                    android:textColor="@color/citron"
                    style="@style/Text.Stamp" />

                <TextView
                    android:id="@+id/text_almost_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="@dimen/space_2xs"
                    android:paddingEnd="@dimen/space_2xl"
                    android:text="@string/heading_almost_sub"
                    style="@style/Text.Body" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_almost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/text_empty_almost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/gutter"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_2xl"
                    android:text="@string/empty_almost"
                    android:visibility="gone"
                    style="@style/Text.Body" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
