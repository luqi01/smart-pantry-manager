<?xml version="1.0" encoding="utf-8"?>
<!--
  Two short lists on one page, told apart by their heading and by what the
  second line of each entry says. The tinted band that used to separate them was
  another block of colour doing a job a heading already does.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_2xl">

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_2xl"
                android:indeterminateTint="@color/pen"
                android:visibility="gone" />

            <TextView
                android:id="@+id/heading_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/page_gutter_end"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/heading_suggested"
                style="@style/Text.Stamp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty_suggested"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/space_2xl"
                android:paddingBottom="@dimen/space_md"
                android:text="@string/empty_suggestions"
                android:visibility="gone"
                style="@style/Text.Note.Quiet" />

            <TextView
                android:id="@+id/heading_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="@dimen/space_xl"
                android:paddingEnd="@dimen/page_gutter_end"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/heading_almost"
                style="@style/Text.Stamp.Pen" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/text_empty_almost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/space_2xl"
                android:text="@string/empty_almost"
                android:visibility="gone"
                style="@style/Text.Note.Quiet" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
