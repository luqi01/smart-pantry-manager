<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/paper"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingStart="@dimen/margin_x"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIconTint="@color/ink"
        app:title="" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/page_gutter_end">

                <TextView
                    android:id="@+id/text_form_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Page" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:text="@string/form_subtitle"
                    style="@style/Text.Note.Quiet" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="@dimen/margin_x"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter"
                android:paddingEnd="@dimen/page_gutter_end">

            <!-- Every field is labelled the same way: a stamped label above the
                 box. Three of the four were labelled that way already while the
                 name floated its label inside the box and the expiry date
                 carried both, which read as two forms spliced together. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2xs"
                android:text="@string/stamp_name"
                style="@style/Text.Stamp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                app:boxStrokeColor="@color/field_stroke"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_name"
                    android:fontFamily="@font/body"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2xs"
                    android:text="@string/hint_quantity"
                    style="@style/Text.Stamp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                    app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_sm"
                    app:boxStrokeColor="@color/field_stroke"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_quantity"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:fontFamily="@font/body"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_2xs"
                        android:text="@string/hint_unit"
                        style="@style/Text.Stamp" />

                    <Spinner
                        android:id="@+id/spinner_unit"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_xl" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_2xs"
                android:text="@string/stamp_expiry"
                style="@style/Text.Stamp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_expiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                app:boxStrokeColor="@color/field_stroke"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_expiry"
                    android:focusable="false"
                    android:fontFamily="@font/body"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- A plain written link. A Material text button carries insets and
                 a minimum width that pushed it out of line with the left edge of
                 every field above it. -->
            <TextView
                android:id="@+id/button_clear_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_min"
                android:paddingEnd="@dimen/space_md"
                android:text="@string/action_clear_date"
                style="@style/Text.Stamp.Pen" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/space_xl"
                android:fontFamily="@font/body"
                android:text="@string/action_save"
        android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/on_ink"
                app:backgroundTint="@color/ink"
                app:cornerRadius="@dimen/radius_md" />

            <!-- Secondary, and styled as secondary. Making both buttons solid
                 would leave the user with no signal about which is the usual
                 action. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/action_delete"
                android:textAllCaps="false"
                android:textColor="@color/pen"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="@dimen/radius_md"
                app:strokeColor="@color/rule"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_width="@dimen/rule_thin"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_x"
        android:background="@color/margin_rule"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
