<?xml version="1.0" encoding="utf-8"?>
<!--
  The list is written straight onto the page: no background of its own, so the
  paper, the ruling and the margin rule all belong to the page rather than to
  this one screen.

  What used to be a row of counts at the top is now a single line at the foot,
  in the italic a note gets added in. It says the one thing the counts were for:
  whether the shelves add up to anything worth cooking.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_pantry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/panel_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The empty page says what to write on it, not that it is empty. -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_gutter"
        android:layout_marginEnd="@dimen/space_2xl"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/panel_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_pantry_title"
            style="@style/Text.Note.Quiet" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/empty_pantry"
            style="@style/Text.Body" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/pen"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/panel_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/strip_ready"
            android:layout_width="match_parent"
            android:layout_height="@dimen/line_pitch"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter_end"
            android:visibility="gone">

            <TextView
                android:id="@+id/text_ready_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="you can make 2 things tonight"
                style="@style/Text.Note" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/action_view"
                style="@style/Text.Stamp.Pen" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_add"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:contentDescription="@string/action_add_ingredient"
            android:fontFamily="@font/body"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.02"
            android:text="@string/action_add_ingredient"
            android:textAllCaps="false"
            android:textColor="@color/on_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ink"
            app:cornerRadius="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/on_ink" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
