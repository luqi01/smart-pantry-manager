<?xml version="1.0" encoding="utf-8"?>
<!--
  A recipe as a line of the same book: name, dot leaders, verdict at the right. The description is not repeated here - it is on the
  recipe's own page, and a list that carries a paragraph per entry stops being
  a list.

  Every row is two line pitches, so the ruling stays regular whichever list the
  row belongs to. The second line is the only thing that differs between them:
  what a recipe takes, or what it still needs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_pitch"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/sit_on_rule">

        <!-- No index. Two lists share this page and both would start at 01,
             and a recipe is an entry rather than a numbered item of stock. The
             space is kept so the names line up with the pantry's. -->
        <Space
            android:layout_width="@dimen/page_gutter"
            android:layout_height="1dp" />

        <!-- Name and leaders share one weighted container so that a long
             recipe name ellipsizes instead of pushing the verdict off the
             right-hand edge. See item_pantry.xml for why. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/space_sm">

            <TextView
                android:id="@+id/text_recipe_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Cheese Omelette"
                style="@style/Text.Item" />

            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:background="@drawable/leader_dots"
                android:layerType="software" />
        </LinearLayout>

        <TextView
            android:id="@+id/stamp_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/page_gutter_end"
            tools:text="ready"
            style="@style/Text.Stamp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_pitch"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/sit_on_rule"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter_end">

        <TextView
            android:id="@+id/text_recipe_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="serves 1 · 10 min · 4 ingredients"
            style="@style/Text.Note.Quiet" />
    </LinearLayout>
</LinearLayout>
