<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_2xl">

        <!-- Grouped under stamped section labels. Previously every control ran
             together in one column, so nothing indicated which settings
             belonged with which. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/stamp_connection"
            style="@style/Text.Stamp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_api_summary"
            style="@style/Text.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_api_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/settings_api_title"
            app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
            app:boxCornerRadiusBottomStart="@dimen/radius_sm"
            app:boxCornerRadiusTopEnd="@dimen/radius_sm"
            app:boxCornerRadiusTopStart="@dimen/radius_sm"
            app:boxStrokeColor="@color/paprika"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_api_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/body"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_test"
            android:textAllCaps="false"
            android:textColor="@color/paprika"
            app:cornerRadius="@dimen/radius_md"
            app:strokeColor="@color/rule"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/stamp_display"
            style="@style/Text.Stamp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFamily="@font/body"
            android:minHeight="@dimen/touch_min"
            android:text="@string/settings_alerts_title"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_alerts_summary"
            style="@style/Text.Meta" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_almost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFamily="@font/body"
            android:minHeight="@dimen/touch_min"
            android:text="@string/settings_almost_title"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_almost_summary"
            style="@style/Text.Meta" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/stamp_defaults"
            style="@style/Text.Stamp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:text="@string/settings_units_title"
            style="@style/Text.Body" />

        <Spinner
            android:id="@+id/spinner_unit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_amount"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_xs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/space_xl"
            android:fontFamily="@font/display"
            android:text="@string/action_save"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/paprika"
            app:cornerRadius="@dimen/radius_md" />

    </LinearLayout>
</ScrollView>
