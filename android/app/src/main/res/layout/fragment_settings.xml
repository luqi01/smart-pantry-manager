<?xml version="1.0" encoding="utf-8"?>
<!--
  The form scrolls; Save does not. It sits on the bottom edge in the same place
  as Add on the pantry screen, so the action is where it is on every other
  screen instead of below the fold on a long form.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/button_save_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_lg">

        <!-- Grouped under stamped section labels, with a rule opening each
             group. Previously every control ran together in one column, so
             nothing indicated which settings belonged with which. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/stamp_connection"
            style="@style/Text.Stamp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_api_summary"
            style="@style/Text.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_api_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:hint="@string/settings_api_title"
            app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
            app:boxCornerRadiusBottomStart="@dimen/radius_sm"
            app:boxCornerRadiusTopEnd="@dimen/radius_sm"
            app:boxCornerRadiusTopStart="@dimen/radius_sm"
            app:boxStrokeColor="@color/tomato"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_api_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/body"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_test"
            android:textAllCaps="false"
            android:textColor="@color/tomato"
            app:cornerRadius="@dimen/radius_md"
            app:strokeColor="@color/rule"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_thin"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@color/rule" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/stamp_display"
            style="@style/Text.Stamp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:fontFamily="@font/body"
            android:minHeight="@dimen/touch_min"
            android:text="@string/settings_alerts_title"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_alerts_summary"
            style="@style/Text.Meta" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_almost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFamily="@font/body"
            android:minHeight="@dimen/touch_min"
            android:text="@string/settings_almost_title"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_almost_summary"
            style="@style/Text.Meta" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_thin"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@color/rule" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/stamp_defaults"
            style="@style/Text.Stamp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xs"
            android:text="@string/settings_units_title"
            style="@style/Text.Body" />

        <Spinner
            android:id="@+id/spinner_unit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_amount"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_xs" />

    </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_save_settings"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:fontFamily="@font/body"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.01"
        android:text="@string/action_save"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textSize="17sp"
        app:backgroundTint="@color/tomato"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
