<?xml version="1.0" encoding="utf-8"?>
<!--
  A line written on a ruled page.

  The row is exactly one line pitch tall, or two when the item carries a use-by
  note, so that the writing always sits on a rule rather than floating between
  them. The rules themselves are drawn by RuledPaperDecoration, not here: a rule
  drawn by the last row would stop where the list stops, and a page is ruled all
  the way down.

  The quantity is set at the same size as the name rather than blown up as a
  figure, and dot leaders carry the eye across to it. It is a list, not a
  dashboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_pitch"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/sit_on_rule">

        <!-- Marginalia: the index is written outside the margin rule, where a
             page number or a tick would go. -->
        <TextView
            android:id="@+id/text_index"
            android:layout_width="@dimen/page_gutter"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="@dimen/space_lg"
            tools:text="02"
            style="@style/Text.Index" />

        <TextView
            android:id="@+id/text_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Cheddar Cheese"
            style="@style/Text.Item" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_xs"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:background="@drawable/leader_dots"
            android:layerType="software" />

        <TextView
            android:id="@+id/text_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="200 g"
            style="@style/Text.Amount" />

        <ImageButton
            android:id="@+id/button_delete"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_2xs"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_delete"
            app:tint="@color/ink_faint" />
    </LinearLayout>

    <!-- The note takes the next line down rather than crowding onto this one. -->
    <LinearLayout
        android:id="@+id/group_expiry"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_pitch"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/sit_on_rule"
        android:paddingStart="@dimen/page_gutter"
        android:paddingEnd="@dimen/page_gutter_end"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="use by 1 Oct"
            style="@style/Text.Note" />
    </LinearLayout>
</LinearLayout>
