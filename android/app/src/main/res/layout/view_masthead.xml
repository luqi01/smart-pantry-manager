<?xml version="1.0" encoding="utf-8"?>
<!--
  The masthead: a solid ink field at the top of every screen carrying the screen
  name and three live counts.

  It replaces a plain toolbar title sitting on the same cream as everything else.
  With no dark mass anywhere, the screens had nothing for the eye to land on and
  read as pale regardless of how carefully the type was set - so the fix is
  structural rather than decorative.

  The counts are real data pulled from the same responses the list below is
  drawn from, not ornament. They also answer the first question a user has on
  opening the app, which is whether anything is about to go off.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/masthead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/field"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_md">

    <TextView
        android:id="@+id/masthead_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        tools:text="In the house"
        style="@style/Text.Stamp.Eyebrow" />

    <TextView
        android:id="@+id/masthead_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/gutter"
        tools:text="Pantry"
        style="@style/Text.Masthead" />

    <!--
      Three cells, hairline-separated. Left-aligned rather than spread across
      the width: a row of centred figures reads as a dashboard widget, and this
      is a heading.
    -->
    <LinearLayout
        android:id="@+id/masthead_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stat_one_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="5"
                style="@style/Text.Figure" />

            <TextView
                android:id="@+id/stat_one_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                tools:text="Items"
                style="@style/Text.Stamp.Light" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/rule_thin"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@color/field_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stat_two_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1"
                style="@style/Text.Figure" />

            <TextView
                android:id="@+id/stat_two_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                tools:text="Use soon"
                style="@style/Text.Stamp.Light" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/rule_thin"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@color/field_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stat_three_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2"
                style="@style/Text.Figure" />

            <TextView
                android:id="@+id/stat_three_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                tools:text="Can cook"
                style="@style/Text.Stamp.Light" />
        </LinearLayout>
    </LinearLayout>

    <!--
      A registration strip, borrowed from the colour bars printed down the edge
      of a press sheet. The three segments are the three states the app deals
      in - stocked, almost, ready - and it gives the block a finished edge
      rather than a flat cut.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@color/tomato" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@color/lime" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@color/grass" />
    </LinearLayout>
</LinearLayout>
