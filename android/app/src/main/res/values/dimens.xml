<?xml version="1.0" encoding="utf-8"?>
<!--
  One 4dp spacing scale, used everywhere. The layouts previously mixed 1, 2, 6,
  10, 12, 20, 44, 48, 72 and 88dp with no system behind it, which is what made
  the screens feel arbitrary even though nothing was obviously wrong.

  Rhythm comes from choosing different steps for different jobs: tight inside a
  group, generous between groups.
-->
<resources>
    <dimen name="space_2xs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_2xl">48dp</dimen>

    <dimen name="gutter">20dp</dimen>          <!-- screen side margin -->
    <dimen name="touch_min">48dp</dimen>
    <dimen name="rule_thin">1dp</dimen>
    <dimen name="radius_sm">6dp</dimen>
    <dimen name="radius_md">10dp</dimen>
</resources>
