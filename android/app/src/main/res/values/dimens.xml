<?xml version="1.0" encoding="utf-8"?>
<!--
  The page.

  A ruled page has one measurement that governs everything: the pitch between
  its lines. Every row in the pantry is one pitch tall, or two when it carries a
  note under it, so the writing always sits on a line rather than floating
  between them. Nothing else is free to pick its own height.

  The margin rule sits at margin_x and the writing starts at page_gutter, a
  little clear of it, exactly as it does in an exercise book.
-->
<resources>
    <dimen name="line_pitch">48dp</dimen>
    <!-- How far the writing is lifted off the rule it sits on. -->
    <dimen name="sit_on_rule">9dp</dimen>
    <dimen name="margin_x">46dp</dimen>
    <dimen name="page_gutter">58dp</dimen>
    <dimen name="page_gutter_end">20dp</dimen>

    <dimen name="space_2xs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_2xl">48dp</dimen>

    <!-- Kept for the screens that are forms rather than lists. -->
    <dimen name="gutter">20dp</dimen>
    <dimen name="touch_min">48dp</dimen>
    <dimen name="rule_thin">1dp</dimen>
    <dimen name="radius_sm">2dp</dimen>
    <dimen name="radius_md">2dp</dimen>
</resources>
