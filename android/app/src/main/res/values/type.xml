<?xml version="1.0" encoding="utf-8"?>
<!--
  Six steps, roughly a 1.3 ratio apart. Fewer sizes with more contrast between
  them reads as a clearer hierarchy than eight sizes a hair apart, and the jump
  from the masthead to everything under it is what makes a screen scan in one
  pass instead of needing to be read.

  Display face is reserved for names, numerals and screen titles. Everything a
  user reads in quantity is set in the body face.
-->
<resources>
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The screen name, reversed out of the ink field. -->
    <style name="Text.Masthead">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Text.Screen">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Text.Item">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <!-- Short all-caps labels only. Never body copy. -->
    <style name="Text.Stamp">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!-- The same stamp, on the ink field. -->
    <style name="Text.Stamp.Light">
        <item name="android:textColor">@color/field_dim</item>
    </style>

    <style name="Text.Stamp.Eyebrow">
        <item name="android:textColor">@color/lime</item>
    </style>

    <!--
      Figures are set in the display face at a size that lets them be read down
      a column rather than word by word. The pantry is a list of quantities and
      the screen should look like one.
    -->
    <style name="Text.Figure">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Text.Amount">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/tomato</item>
    </style>

    <!-- The row index down the left edge of every list. -->
    <style name="Text.Index">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/grass_wash</item>
        <item name="android:width">58dp</item>
        <item name="android:height">30dp</item>
        <item name="marginHorizontal">@dimen/space_xs</item>
    </style>
</resources>
