<?xml version="1.0" encoding="utf-8"?>
<!--
  Two faces with different jobs, rather than two grotesques doing the same one.

  Vollkorn, the serif, is the voice: screen names, recipe and ingredient names,
  and the quantity figures a pantry exists to report. Archivo, the grotesque, is
  the apparatus: running text, the stamped labels, the row indices.

  Six steps, roughly a 1.3 ratio apart. Fewer sizes with more contrast between
  them reads as a clearer hierarchy than eight sizes a hair apart, and the jump
  from the masthead to everything under it is what lets a screen scan in one
  pass instead of having to be read.

  Tracking note: the grotesque takes tight tracking at display sizes and wide
  tracking in caps. The serif wants neither - its proportions are already set by
  the design, and pulling it tight closes up the serifs.
-->
<resources>
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFeatureSettings">lnum</item>
    </style>

    <!--
      Font padding is dropped only on the large display sizes, where the extra
      leading above a 36sp line is visible slack. Leaving it off everywhere
      clipped the descenders of wrapped body text, which is what it is there
      to protect.
    -->
    <style name="Text.Tight">
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The screen name, reversed out of the field. -->
    <style name="Text.Masthead" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Text.Screen" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Text.Title" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Item" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <!-- Short all-caps labels only. Never body copy. -->
    <style name="Text.Stamp" parent="Text.Tight">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!-- The same stamp, on the field. -->
    <style name="Text.Stamp.Light">
        <item name="android:textColor">@color/field_dim</item>
    </style>

    <style name="Text.Stamp.Eyebrow">
        <item name="android:textColor">@color/lime</item>
    </style>

    <!--
      Figures are set in the serif at a size that lets them be read down a
      column rather than word by word. The pantry is a list of quantities and
      the screen should look like one.
    -->
    <style name="Text.Figure" parent="Text.Tight">
        <item name="android:fontFeatureSettings">lnum, tnum</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Text.Amount" parent="Text.Tight">
        <item name="android:fontFeatureSettings">lnum, tnum</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tomato</item>
    </style>

    <!-- The row index down the left edge of every list. Apparatus, so it is set
         in the grotesque and stays out of the way of the names beside it. -->
    <style name="Text.Index" parent="Text.Tight">
        <item name="android:fontFeatureSettings">lnum, tnum</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!--
      The navigation bar. Material's pill behind the selected icon is the most
      recognisable stock Android component on the screen, so the indicator is
      squared off to match the stamps and tickets everything else is built from.
    -->
    <style name="NavIndicatorShape" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/grass_wash</item>
        <item name="android:width">64dp</item>
        <item name="android:height">30dp</item>
        <item name="shapeAppearance">@style/NavIndicatorShape</item>
        <item name="marginHorizontal">@dimen/space_xs</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
