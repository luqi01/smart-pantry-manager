<?xml version="1.0" encoding="utf-8"?>
<!--
  Two faces, doing what a pen and a printer do.

  Vollkorn is what is written on the page: names, quantities, the notes under a
  line. Archivo is what is printed on it: the small labels, the index down the
  margin, the buttons. Nothing is set large enough to be a headline, because a
  list does not have headlines - the page title is the only thing that leads,
  and it leads by a single step rather than by three.
-->
<resources>
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFeatureSettings">lnum</item>
    </style>

    <style name="Text.Tight">
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- The name of the page, written at the top of it. -->
    <style name="Text.Page" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Screen" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Title" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A line of the list: the name, and the quantity it runs out to. -->
    <style name="Text.Item" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Amount" parent="Text.Item">
        <item name="android:fontFeatureSettings">lnum, tnum</item>
    </style>

    <!--
      Notes. Written in italic and in red, which is what a second pass over a
      list looks like: the thing added after the list was made.
    -->
    <style name="Text.Note" parent="Text.Tight">
        <item name="android:fontFamily">@font/display</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/pen</item>
    </style>

    <style name="Text.Note.Quiet">
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <style name="Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>

    <!-- Printed labels. Short and in caps only. -->
    <style name="Text.Stamp" parent="Text.Tight">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <style name="Text.Stamp.Pen">
        <item name="android:textColor">@color/pen</item>
    </style>

    <!-- Down the margin, outside the rule. -->
    <style name="Text.Index" parent="Text.Tight">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFeatureSettings">lnum, tnum</item>
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <!--
      The tabs are the divider tabs of a book, and the selected one is inked
      in: a solid black block with the icon reversed out of it, and the name
      printed underneath on the paper.

      Material's stock pill is the most recognisable component on the screen and
      a page does not have one. It also signalled the selected tab by colour
      alone, which is invisible to anyone who cannot separate the red from the
      grey; a filled block is a second, non-colour signal.
    -->
    <style name="ShapeAppearance.Nav.Tab" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/ink</item>
        <item name="android:width">44dp</item>
        <item name="android:height">34dp</item>
        <item name="marginHorizontal">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Nav.Tab</item>
    </style>

    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- The selected name is set heavier as well as darker, so the tab is
         marked twice over. -->
    <style name="NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
