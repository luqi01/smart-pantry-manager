<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartPantry" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pen</item>
        <item name="colorOnPrimary">@color/on_ink</item>
        <item name="colorPrimaryContainer">@color/pen_faint</item>
        <item name="colorOnPrimaryContainer">@color/pen</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/paper_edge</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorError">@color/pen</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/rule</item>
        <!-- The page runs to the top of the screen, so the status bar is the
             same paper rather than a band above it. -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:textViewStyle">@style/AppTextView</item>
    </style>

    <style name="AppTextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/body</item>
        <item name="android:fontFeatureSettings">lnum</item>
    </style>
</resources>
