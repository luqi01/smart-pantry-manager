<?xml version="1.0" encoding="utf-8"?>
<!--
  Larder palette. Warm throughout: no pure black, no pure white, and the
  neutrals are tinted toward the paprika hue so the surfaces and the accent
  feel related rather than merely adjacent.

  Weighting is roughly 60 / 30 / 10 - paper and ink carry the screen, and
  paprika is rare enough to still mean something when it appears.
-->
<resources>
    <!-- surfaces -->
    <color name="paper">#F6F1E8</color>          <!-- kraft, the app background -->
    <color name="paper_raised">#FCF9F3</color>   <!-- a shade lighter, for rows -->
    <color name="paper_sunken">#EDE5D7</color>   <!-- pressed and inset states -->

    <!-- ink -->
    <color name="ink">#231C16</color>            <!-- warm near-black, never #000 -->
    <color name="ink_muted">#6E6157</color>
    <color name="ink_faint">#A2958A</color>
    <color name="rule">#DFD5C4</color>           <!-- hairline dividers -->

    <!-- accents -->
    <color name="paprika">#A83B12</color>        <!-- primary: labels, actions -->
    <color name="paprika_wash">#F2DFD4</color>
    <color name="olive">#4F5D2B</color>          <!-- affirmative: can cook now -->
    <color name="olive_wash">#E4E7D2</color>
    <color name="mustard">#8A6410</color>        <!-- almost there -->
    <color name="mustard_wash">#F3E8CC</color>
    <color name="rust">#8F2D1B</color>           <!-- destructive, expiring -->

    <color name="white">#FFFFFF</color>
</resources>
