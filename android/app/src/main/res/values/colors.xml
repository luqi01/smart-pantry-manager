<?xml version="1.0" encoding="utf-8"?>
<!--
  Paper, ink and a red pen. That is the whole palette.

  The app is a pantry book: a ruled page someone keeps a list on. A ruled page
  is printed in one faint colour and written on in one or two, so a third
  accent would be a decision nobody makes when actually keeping a list.

  Ink is blue-black because that is what a pen holds, not black. The ruling is
  the pale blue of a printed exercise book, and the margin rule is the faded red
  that runs down one. Red is reserved for what a person would reach for a red
  pen to mark: something about to go off, something missing, something to undo.
-->
<resources>
    <!-- the page -->
    <color name="paper">#F8F5EC</color>          <!-- warm paper, never #fff -->
    <color name="paper_edge">#EFEADC</color>     <!-- pressed states, inset fields -->

    <!-- what is written on it -->
    <color name="ink">#1E2A3A</color>            <!-- blue-black, never #000 -->
    <color name="ink_muted">#5B6676</color>
    <color name="ink_faint">#97A0AC</color>

    <!-- what is printed on it -->
    <color name="rule">#C8D2DF</color>           <!-- the ruling -->
    <color name="rule_faint">#DDE4EC</color>
    <color name="margin_rule">#E0A9A4</color>    <!-- the red line down the page -->

    <!-- the red pen -->
    <color name="pen">#A6342C</color>
    <color name="pen_faint">#F0DAD6</color>

    <color name="on_ink">#F8F5EC</color>         <!-- paper, reversed out of ink -->
</resources>
